<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33F59E0B">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#E6121622"
                android:startColor="#EB1D1A21"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.25dp"
                android:color="@color/glass_stroke_amber" />
        </shape>
    </item>
</ripple>
