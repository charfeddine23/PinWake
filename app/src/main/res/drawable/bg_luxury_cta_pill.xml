<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#59FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:centerColor="#06B6D4"
                        android:endColor="#10B981"
                        android:startColor="#22E6FF"
                        android:type="linear" />
                    <corners android:radius="999dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#80FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:centerColor="#08FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:startColor="#30FFFFFF"
                        android:type="linear" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
