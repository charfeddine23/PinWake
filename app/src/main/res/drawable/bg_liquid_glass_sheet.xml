<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#F50B111E"
                android:endColor="@color/glass_sheet_end"
                android:startColor="#F2141E30"
                android:type="linear" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#36FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#05FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#16FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="27dp"
                android:topRightRadius="27dp" />
        </shape>
    </item>
</layer-list>
