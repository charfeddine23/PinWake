<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3022D3EE">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#EB121B2B"
                        android:startColor="#F21A263C"
                        android:type="linear" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#4D22D3EE" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:centerColor="#04FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:startColor="#14FFFFFF"
                        android:type="linear" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
