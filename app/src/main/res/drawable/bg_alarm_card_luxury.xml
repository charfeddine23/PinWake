<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2622D3EE">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/glass_fill_end"
                        android:startColor="#D9151F31"
                        android:type="linear" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#2EFFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:centerColor="#03FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:startColor="#12FFFFFF"
                        android:type="linear" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
