<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2622D3EE">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_fill_end"
                android:startColor="@color/glass_card_fill"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke_subtle" />
        </shape>
    </item>
</ripple>
