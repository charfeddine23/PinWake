<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_midnight"
    android:layoutDirection="ltr"
    tools:context=".ui.map.MapPickerActivity">

    <!-- Visible Map Viewport (centered above mobility sheet so crosshair & geofence stay clear) -->
    <FrameLayout
        android:id="@+id/mapViewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomSheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.ui.widget.LiquidGlassTopFadeView
            android:id="@+id/topLiquidGlassBlur"
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_gravity="top"
            android:elevation="5dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_map_scrim_bottom" />

        <!-- Exact Target Ground Dot underneath the Floating Center Pin -->
        <View
            android:id="@+id/viewPinShadow"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_cyan"
            android:elevation="5dp" />

        <!-- Animated Center Pin Container (lifts on drag, bounces down on idle, shows pin type) -->
        <FrameLayout
            android:id="@+id/layoutCrosshairContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginBottom="22dp"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/ivCrosshair"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/map_crosshair_cd"
                android:src="@drawable/ic_crosshair_pin"
                app:tint="@color/accent_cyan" />

            <View
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_circle_dark" />

            <ImageView
                android:id="@+id/ivCrosshairCategoryIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alarm_bell"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Map Layer Switcher FAB -->
        <ImageButton
            android:id="@+id/fabMapStyle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="78dp"
            android:background="@drawable/bg_liquid_glass_pill"
            android:contentDescription="@string/cd_map_layers"
            android:elevation="7dp"
            android:padding="13dp"
            android:src="@drawable/ic_layers" />

        <!-- Sleek Glassmorphic Map Layers Popup (Google Dark, Google Light, 3D Buildings) -->
        <LinearLayout
            android:id="@+id/cardMapStyleMenu"
            android:layout_width="224dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="76dp"
            android:layout_marginBottom="78dp"
            android:background="@drawable/bg_liquid_glass_search"
            android:elevation="9dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:paddingHorizontal="8dp"
                android:text="@string/map_layers_title"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/optMapGoogleDark"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/map_style_dark"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/optMapGoogleLight"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/map_style_light"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="@color/glass_stroke_subtle" />

            <LinearLayout
                android:id="@+id/rowToggle3dBuildings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/map_3d_buildings"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch3dBuildings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- Current Location FAB -->
        <ImageButton
            android:id="@+id/fabMyLocation"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_liquid_glass_pill"
            android:contentDescription="@string/map_current_location_cd"
            android:elevation="7dp"
            android:padding="13dp"
            android:src="@drawable/ic_my_location" />
    </FrameLayout>

    <!-- Floating Search Pill Bar (Uber / Yassir Destination Search) -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_liquid_glass_search"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnMapBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/map_back_cd"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/map_search_hint"
            android:src="@drawable/ic_search"
            app:tint="@color/accent_cyan_glow" />

        <EditText
            android:id="@+id/etSearchPlace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/map_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progressSearch"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="@color/accent_cyan"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnClearSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_clear_search"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Autocomplete Results Overlay -->
    <LinearLayout
        android:id="@+id/cardSearchResults"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_liquid_glass_search"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="240dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchBarContainer">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Bottom Mobility Confirmation Sheet -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_liquid_glass_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_liquid_glass_pill" />

        <!-- Sheet Title & Live Mono Coordinates Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_sheet_title"
                android:textAppearance="@style/TextAppearance.PinWake.Title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCoordinatesMono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_liquid_glass_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/accent_cyan_glow"
                android:textSize="10sp"
                tools:text="48.85660, 2.35220" />
        </LinearLayout>

        <!-- Resolved Address -->
        <TextView
            android:id="@+id/tvResolvedAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/map_resolving_address"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Alarm Title Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAlarmTitle"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/map_label_hint"
            app:boxBackgroundColor="@color/bg_surface_input"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/glass_stroke_cyan">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAlarmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Favorite Category Tag Selector -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNone"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/fav_none"
                    app:chipIcon="@drawable/ic_alarm_bell"
                    app:chipIconTint="@color/accent_cyan" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHome"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fav_home"
                    app:chipIcon="@drawable/ic_home"
                    app:chipIconTint="@color/accent_emerald" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWork"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fav_work"
                    app:chipIcon="@drawable/ic_work"
                    app:chipIconTint="@color/accent_amber" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStation"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fav_station"
                    app:chipIcon="@drawable/ic_train"
                    app:chipIconTint="@color/accent_cyan_glow" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCustom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fav_custom"
                    app:chipIcon="@drawable/ic_star"
                    app:chipIconTint="@color/accent_cyan_glow" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Radius Slider Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_radius_label"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRadiusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_cyan"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/accent_cyan_glow"
                android:textSize="12sp"
                tools:text="500 m" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderRadius"
            style="@style/Widget.PinWake.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="50.0"
            android:value="500.0"
            android:valueFrom="200.0"
            android:valueTo="5000.0" />

        <!-- Confirm & Activate Button -->
        <TextView
            android:id="@+id/btnSaveAlarm"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_cyan_gradient_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/map_save_activate"
            android:textColor="@color/text_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
