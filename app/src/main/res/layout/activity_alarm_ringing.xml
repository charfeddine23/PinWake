<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_midnight"
    android:layoutDirection="ltr"
    android:paddingHorizontal="24dp"
    tools:context=".ui.alarm.AlarmRingingActivity">

    <!-- Top Alert Badge -->
    <TextView
        android:id="@+id/tvRingingBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_badge_rose"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/alarm_ringing_badge"
        android:textAppearance="@style/TextAppearance.PinWake.Mono"
        android:textColor="@color/accent_rose"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Animated Radar Pulse & Center Pin Emblem -->
    <FrameLayout
        android:id="@+id/radarContainer"
        android:layout_width="250dp"
        android:layout_height="250dp"
        app:layout_constraintBottom_toTopOf="@+id/tvAlarmTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRingingBadge">

        <com.example.ui.alarm.RadarPulseView
            android:id="@+id/radarPulseView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_liquid_glass_card_active"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_alarm_icon"
                android:src="@drawable/ic_alarm_bell" />

            <TextView
                android:id="@+id/tvDistanceRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/accent_cyan_glow"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="320 m" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvAlarmTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.PinWake.Display"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvAlarmAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radarContainer"
        tools:text="Central Station" />

    <TextView
        android:id="@+id/tvAlarmAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/tvAlarmSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAlarmTitle"
        tools:text="Main Transit Concourse, Downtown" />

    <TextView
        android:id="@+id/tvAlarmSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_badge_cyan"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/accent_cyan_glow"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@+id/btnSnooze500m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAlarmAddress"
        tools:text="Inside 500 m wake geofence" />

    <!-- Snooze 500m Button -->
    <LinearLayout
        android:id="@+id/btnSnooze500m"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_liquid_glass_pill"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/slideToDismiss"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/alarm_snooze_500m"
            android:src="@drawable/ic_snooze" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/alarm_snooze_500m"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Slide to Dismiss Control -->
    <com.example.ui.alarm.SlideToDismissView
        android:id="@+id/slideToDismiss"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
