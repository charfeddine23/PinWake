<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_liquid_glass_sheet"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Pill -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_liquid_glass_pill" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivQuickAssignIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_circle_dark"
            android:contentDescription="@string/quick_assign_title"
            android:padding="8dp"
            android:src="@drawable/ic_home"
            app:tint="@color/accent_emerald" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_assign_title"
                android:textAppearance="@style/TextAppearance.PinWake.Title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuickAssignCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/accent_cyan_glow"
                android:textSize="11sp"
                tools:text="36.75380, 3.05880" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvQuickAssignAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/map_resolving_address"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Category Selection Grid (Home, Work, Station, Other) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupQuickAssign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAssignHome"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/fav_home"
            android:textColor="@color/text_primary"
            app:chipBackgroundColor="@color/bg_surface_input"
            app:chipIcon="@drawable/ic_home"
            app:chipIconTint="@color/accent_emerald"
            app:chipStrokeColor="@color/glass_stroke_subtle" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAssignWork"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fav_work"
            android:textColor="@color/text_primary"
            app:chipBackgroundColor="@color/bg_surface_input"
            app:chipIcon="@drawable/ic_work"
            app:chipIconTint="@color/accent_amber"
            app:chipStrokeColor="@color/glass_stroke_subtle" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAssignStation"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fav_station"
            android:textColor="@color/text_primary"
            app:chipBackgroundColor="@color/bg_surface_input"
            app:chipIcon="@drawable/ic_train"
            app:chipIconTint="@color/accent_cyan_glow"
            app:chipStrokeColor="@color/glass_stroke_subtle" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAssignOther"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_assign_other"
            android:textColor="@color/text_primary"
            app:chipBackgroundColor="@color/bg_surface_input"
            app:chipIcon="@drawable/ic_star"
            app:chipIconTint="@color/accent_cyan"
            app:chipStrokeColor="@color/glass_stroke_subtle" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAssignPin"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fav_none"
            android:textColor="@color/text_primary"
            app:chipBackgroundColor="@color/bg_surface_input"
            app:chipIcon="@drawable/ic_alarm_bell"
            app:chipIconTint="@color/accent_cyan"
            app:chipStrokeColor="@color/glass_stroke_subtle" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Custom Title Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilQuickAssignTitle"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/quick_assign_name_hint"
        app:boxBackgroundColor="@color/bg_surface_input"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/glass_stroke_bright"
        app:hintTextColor="@color/accent_cyan_glow">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuickAssignTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Radius Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_radius_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuickAssignRadius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textAppearance="@style/TextAppearance.PinWake.Mono"
            android:textColor="@color/accent_cyan_glow"
            android:textSize="12sp"
            tools:text="500 m" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderQuickAssignRadius"
        style="@style/Widget.PinWake.Slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="50.0"
        android:value="500.0"
        android:valueFrom="200.0"
        android:valueTo="5000.0" />

    <!-- Optional Immediate Alarm Activation Switch -->
    <LinearLayout
        android:id="@+id/rowQuickAssignAlarmToggle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quick_assign_activate_alarm"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchQuickAssignActive"
            style="@style/Widget.PinWake.Switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

    <!-- Primary Confirm Button -->
    <TextView
        android:id="@+id/btnQuickAssignConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_luxury_cta_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/quick_assign_save"
        android:textColor="@color/text_on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
