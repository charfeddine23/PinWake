<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAlarmRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_alarm_card_luxury"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Row 1: Animated Radar Emblem, Category Eyebrow, Title & Arm Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/viewRadarHalo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_radar_halo_ring"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_icon_circle_dark"
                android:contentDescription="@string/cd_alarm_icon"
                android:padding="10dp"
                android:src="@drawable/ic_pin_wake" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotAlarmStatus"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_badge_emerald" />

                <TextView
                    android:id="@+id/tvAlarmCategoryEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.PinWake.Mono"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    tools:text="HOME · ARMED" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAlarmName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.PinWake.Title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Central Station" />

            <TextView
                android:id="@+id/tvAlarmAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Downtown Transit Hub, Main St" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAlarmActive"
            style="@style/Widget.PinWake.Switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp" />
    </LinearLayout>

    <!-- Gradient Hairline Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="13dp"
        android:background="@drawable/bg_hairline_gradient" />

    <!-- Row 2: Live Distance, Radius, Ringtone & Vibration Telemetry Strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDistanceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_cyan"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="172dp"
                android:paddingHorizontal="11dp"
                android:paddingVertical="5dp"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/accent_cyan_glow"
                android:textSize="11sp"
                tools:text="2.4 km away" />

            <TextView
                android:id="@+id/tvRadiusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="11dp"
                android:paddingVertical="5dp"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="500 m radius" />

            <TextView
                android:id="@+id/tvRingtoneBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_cyan"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="136dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/accent_cyan_glow"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="♪ Radar"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/badgeVibrateOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_cyan"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_vibration"
                    app:tint="@color/accent_cyan_glow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:text="@string/badge_vibrate_on"
                    android:textAppearance="@style/TextAppearance.PinWake.Mono"
                    android:textColor="@color/accent_cyan_glow"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Row 3: Ergonomic Action Dock (Primary Navigate + Edit + Share + Delete, All >= 48dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnNavigateAlarm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.08"
            android:background="@drawable/bg_luxury_glass_pill_cyan"
            android:clickable="true"
            android:contentDescription="@string/cd_navigate_alarm"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_navigation"
                app:tint="@color/accent_cyan_glow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_assist_navigate"
                android:textColor="@color/accent_cyan_glow"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnEditAlarm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_luxury_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/action_edit_on_map"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnShareAlarm"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_luxury_glass_pill"
            android:contentDescription="@string/cd_share_destination"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_share"
            app:tint="@color/accent_cyan_glow" />

        <ImageButton
            android:id="@+id/btnDeleteAlarm"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_luxury_glass_pill_rose"
            android:contentDescription="@string/cd_delete_alarm"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="@color/accent_rose" />
    </LinearLayout>

</LinearLayout>
