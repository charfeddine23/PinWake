<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_midnight"
    android:layoutDirection="ltr"
    tools:context=".MainActivity">

    <!-- Full-Screen Map Backdrop (Expands 100% when sheet is pulled down) -->
    <FrameLayout
        android:id="@+id/mapHeroContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.maplibre.android.maps.MapView
            android:id="@+id/dashboardMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Bottom Atmospheric Scrim (Fades out in Full Map Mode) -->
        <View
            android:id="@+id/mapScrimBottom"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_map_scrim_bottom" />

        <!-- Hero Overlay: Tap to open Picker or Pull Down for Full-Screen Map -->
        <View
            android:id="@+id/btnMapHeroTap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="@string/btn_new_alarm"
            android:focusable="true" />
    </FrameLayout>

    <!-- Live Radar Pill anchored dynamically above Sheet Edge -->
    <LinearLayout
        android:id="@+id/pillLiveRadar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:background="@drawable/bg_liquid_glass_pill"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <View
            android:id="@+id/viewHeroRadarDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_badge_emerald" />

        <TextView
            android:id="@+id/tvHeroRadarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/hero_live_radar"
            android:textAppearance="@style/TextAppearance.PinWake.Mono"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Fade-to-Blur Liquid Glass Canopy -->
    <com.example.ui.widget.LiquidGlassTopFadeView
        android:id="@+id/topLiquidGlassBlur"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:layout_gravity="top"
        android:elevation="9dp" />

    <!-- Floating Top Command Bar (Always visible in all modes including Full Map) -->
    <LinearLayout
        android:id="@+id/topFloatingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/pillBrandHeader"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_luxury_glass_pill"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="15dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle_dark"
                android:contentDescription="@string/app_name"
                android:padding="6dp"
                android:src="@drawable/ic_pin_wake" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:letterSpacing="0.01"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.PinWake.Title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopVersionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_cyan"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.PinWake.Mono"
                android:textColor="@color/accent_cyan_glow"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="v1.0.11" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_luxury_glass_pill"
            android:clickable="true"
            android:contentDescription="@string/cd_settings"
            android:elevation="6dp"
            android:focusable="true">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />

            <View
                android:id="@+id/dotSettingsAttention"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_badge_emerald"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Draggable Mobility Bottom Sheet (Pull down to leave only "Where are you heading?") -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_liquid_glass_sheet"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:fillViewport="true"
        android:paddingBottom="104dp"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.68"
        app:behavior_hideable="false"
        app:behavior_peekHeight="116dp"
        app:behavior_skipCollapsed="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="2dp">

            <!-- Drag Handle (Tap or drag down for Full Map Mode) -->
            <FrameLayout
                android:id="@+id/layoutSheetHandle"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:clickable="true"
                android:contentDescription="@string/cd_drag_sheet"
                android:focusable="true">

                <View
                    android:id="@+id/viewSheetHandle"
                    android:layout_width="42dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_liquid_glass_pill" />
            </FrameLayout>

            <!-- Uber / Yassir "Where are you heading?" Hero Search Bar -->
            <LinearLayout
                android:id="@+id/btnWhereTo"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@drawable/bg_where_to_box"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_circle_dark"
                    android:contentDescription="@string/where_to_hint"
                    android:padding="10dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/accent_cyan_glow" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/where_to_hint"
                        android:textAppearance="@style/TextAppearance.PinWake.Title"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/where_to_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_badge_cyan"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/where_to_map_chip"
                    android:textColor="@color/accent_cyan_glow"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Collapsible Sheet Body (Hidden when pulled down to Full Map Mode) -->
            <LinearLayout
                android:id="@+id/sheetBodyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Live Adaptive Tracking Status Banner -->
            <LinearLayout
                android:id="@+id/cardLiveTelemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_liquid_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <View
                    android:id="@+id/viewTrackingDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_badge_cyan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTrackingTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/status_standby"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrackingSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/app_tagline"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPollingTierBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_cyan"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/status_standby"
                    android:textAppearance="@style/TextAppearance.PinWake.Mono"
                    android:textColor="@color/accent_cyan_glow"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/btnShareTripStatus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_luxury_glass_pill"
                    android:contentDescription="@string/cd_share_destination"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_share"
                    android:visibility="gone"
                    app:tint="@color/accent_cyan_glow"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Quick Favorite Destinations Strip (Uber / Yassir Shortcuts) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/section_quick_favorites"
                android:textAppearance="@style/TextAppearance.PinWake.Title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Home Quick Card -->
                <LinearLayout
                    android:id="@+id/cardFavHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:minHeight="94dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_dark"
                        android:contentDescription="@string/fav_home"
                        android:padding="9dp"
                        android:src="@drawable/ic_home" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fav_home"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFavHomeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/fav_tap_to_pin"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Work Quick Card -->
                <LinearLayout
                    android:id="@+id/cardFavWork"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:minHeight="94dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_dark"
                        android:contentDescription="@string/fav_work"
                        android:padding="9dp"
                        android:src="@drawable/ic_work" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fav_work"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFavWorkStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/fav_tap_to_pin"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Station Quick Card -->
                <LinearLayout
                    android:id="@+id/cardFavStation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:minHeight="94dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_dark"
                        android:contentDescription="@string/fav_station"
                        android:padding="9dp"
                        android:src="@drawable/ic_train" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fav_station"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFavStationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/fav_tap_to_pin"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- GPS Alarms Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_gps_alarms"
                    android:textAppearance="@style/TextAppearance.PinWake.Title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveAlarmCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_liquid_glass_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="1 Active" />
            </LinearLayout>

            <!-- Alarms RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAlarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_alarm_card" />

            <!-- Empty Alarms State -->
            <LinearLayout
                android:id="@+id/emptyAlarmsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_liquid_glass_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_icon_circle_dark"
                    android:contentDescription="@string/cd_alarm_icon"
                    android:padding="12dp"
                    android:src="@drawable/ic_pin_wake" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/empty_alarms_title"
                    android:textAppearance="@style/TextAppearance.PinWake.Title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/empty_alarms_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Trip History Section -->
            <LinearLayout
                android:id="@+id/sectionHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_trip_history"
                        android:textAppearance="@style/TextAppearance.PinWake.Title"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/action_clear_history"
                        android:textColor="@color/accent_cyan_glow"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTripHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_trip_history" />
            </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Primary Pin New Alarm CTA Button -->
    <LinearLayout
        android:id="@+id/fabPinAlarm"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_luxury_cta_pill"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle_dark"
            android:contentDescription="@string/btn_new_alarm"
            android:padding="8dp"
            android:src="@drawable/ic_add"
            app:tint="@color/accent_cyan_glow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:letterSpacing="0.01"
            android:text="@string/btn_new_alarm"
            android:textColor="@color/text_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full-Map Quick Stacked Dock (Top: My Location, Middle: Work, Bottom: Home) -->
    <LinearLayout
        android:id="@+id/stackQuickFavMapButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="132dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="11dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="invisible"
        tools:visibility="visible">

        <!-- Current GPS Location Button (above Work) -->
        <ImageButton
            android:id="@+id/btnMyLocationFullMap"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_luxury_glass_pill"
            android:contentDescription="@string/map_current_location_cd"
            android:elevation="8dp"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_my_location"
            app:tint="@color/accent_cyan_glow" />

        <!-- Work Quick Fly-To Pill -->
        <LinearLayout
            android:id="@+id/btnQuickWorkFullMap"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_luxury_glass_pill"
            android:clickable="true"
            android:contentDescription="@string/fav_work"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="136dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/ivQuickWorkFullMap"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_circle_dark"
                android:contentDescription="@string/fav_work"
                android:padding="6dp"
                android:src="@drawable/ic_work"
                app:tint="@color/accent_amber" />

            <TextView
                android:id="@+id/tvQuickWorkFullMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/fav_work"
                android:textAppearance="@style/TextAppearance.PinWake.Title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/dotQuickWorkFullMap"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_badge_cyan" />
        </LinearLayout>

        <!-- Home Quick Fly-To Pill -->
        <LinearLayout
            android:id="@+id/btnQuickHomeFullMap"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_luxury_glass_pill"
            android:clickable="true"
            android:contentDescription="@string/fav_home"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="136dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/ivQuickHomeFullMap"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_circle_dark"
                android:contentDescription="@string/fav_home"
                android:padding="6dp"
                android:src="@drawable/ic_home"
                app:tint="@color/accent_emerald" />

            <TextView
                android:id="@+id/tvQuickHomeFullMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/fav_home"
                android:textAppearance="@style/TextAppearance.PinWake.Title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/dotQuickHomeFullMap"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_badge_emerald" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
