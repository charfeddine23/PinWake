<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootTripsHistory"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_midnight"
    android:layoutDirection="ltr"
    tools:context=".ui.history.TripsHistoryActivity">

    <!-- Trips History List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTripsHistoryPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="84dp"
        android:paddingBottom="32dp"
        tools:itemCount="3"
        tools:listitem="@layout/item_trip_history" />

    <!-- Empty History State -->
    <LinearLayout
        android:id="@+id/emptyHistoryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_alarm_card_luxury"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_circle_dark"
            android:contentDescription="@string/section_trip_history"
            android:padding="13dp"
            android:src="@drawable/ic_replay"
            app:tint="@color/accent_emerald" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/empty_history_title"
            android:textAppearance="@style/TextAppearance.PinWake.Title"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/empty_history_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Solid Dark Liquid Glass Top Bar -->
    <LinearLayout
        android:id="@+id/historyTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E60B0F19"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnHistoryBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_luxury_glass_pill"
                android:contentDescription="@string/map_back_cd"
                android:elevation="4dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back_arrow" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_luxury_glass_pill"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/section_trip_history"
                    android:src="@drawable/ic_replay"
                    app:tint="@color/accent_emerald" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/section_trip_history"
                    android:textAppearance="@style/TextAppearance.PinWake.Title"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnHistoryClearAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_luxury_glass_pill_rose"
                android:clickable="true"
                android:contentDescription="@string/action_clear_history"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:text="@string/action_clear_history"
                android:textColor="@color/accent_rose"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF" />
    </LinearLayout>

</FrameLayout>
