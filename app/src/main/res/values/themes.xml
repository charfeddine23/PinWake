<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PinWake" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_cyan_tint</item>
        <item name="colorOnPrimaryContainer">@color/accent_cyan_glow</item>
        <item name="colorSecondary">@color/accent_emerald</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_emerald_tint</item>
        <item name="colorOnSecondaryContainer">@color/accent_emerald</item>
        <item name="colorError">@color/accent_rose</item>
        <item name="colorOnError">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_midnight</item>
        <item name="colorSurface">@color/bg_surface_deep</item>
        <item name="colorSurfaceVariant">@color/bg_surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/glass_stroke_subtle</item>

        <item name="android:windowBackground">@color/bg_midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="Theme.PinWake.Alarm" parent="Theme.PinWake">
        <item name="android:windowBackground">@color/bg_midnight</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="TextAppearance.PinWake.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PinWake.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PinWake.Mono" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>

    <style name="Widget.PinWake.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/accent_cyan</item>
        <item name="trackColorInactive">@color/glass_stroke_subtle</item>
        <item name="thumbColor">@color/accent_cyan_glow</item>
        <item name="haloColor">@color/accent_cyan_tint</item>
        <item name="trackHeight">8dp</item>
        <item name="thumbRadius">12dp</item>
        <item name="tickVisible">false</item>
    </style>

    <style name="Widget.PinWake.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/selector_switch_track</item>
        <item name="thumbTint">@color/selector_switch_thumb</item>
    </style>

</resources>
